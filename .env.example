# --- Profil ---
# Mały VPS (np. OVH VPS-1): odkomentuj, by używać limitów z docker-compose.small.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.small.yml

# --- Adres publiczny ---
# Domena => Caddy sam pobierze certyfikat Let's Encrypt.
# Lokalnie użyj "localhost" (certyfikat wewnętrzny Caddy) albo ":80" (bez SSL).
SITE_ADDRESS=localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=sophia
POSTGRES_USER=sophia
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_PORT=5432

# --- API ---
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
JWT_TTL_MINUTES=720
# Konto administratora tworzone przy pierwszym starcie API (jeśli nie istnieje)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=zmien-mnie
# Maks. rozmiar pojedynczego załącznika PDF (MB)
MAX_ATTACHMENT_MB=50

# --- QGIS Server ---
# Domyślnie QGIS 4.2 (Qt6). Wersja serwera musi być >= wersji QGIS Desktop, w której
# zapisano projekt (projekt z 4.x nie otworzy się na serwerze 3.x).
# Konserwatywnie (LTR 3.44): QGIS_SERVER_IMAGE=camptocamp/qgis-server:3.44
# QGIS_SERVER_IMAGE=camptocamp/qgis-server:4.2

# --- Kopie zapasowe (scripts/server/backup.sh) ---
# Zdalne miejsce rclone, np. OVH Object Storage; puste = tylko kopie lokalne
# RCLONE_REMOTE=ovh:sophia-backup
