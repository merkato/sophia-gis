{
	email {$ACME_EMAIL}
}

# Caddy Sophii jest głównym proxy serwera (porty 80/443, certyfikaty dla wszystkich subdomen).
# Inne usługi na tym samym VPS dopisujesz jako pliki proxy/sites/<nazwa>.caddy — patrz proxy/sites/README.md.
import /etc/caddy/sites/*.caddy

{$SITE_ADDRESS} {
	encode zstd gzip

	# --- API ---
	handle /api/* {
		request_body {
			max_size 100MB
		}
		reverse_proxy api:8000
	}

	# --- QGIS Server (WMS/WMTS/WFS/GetPrint) ---
	# Każde żądanie przechodzi przez forward_auth: API sprawdza token, projekt (MAP)
	# i warstwy (LAYERS/QUERY_LAYERS/TYPENAME) względem uprawnień grupy użytkownika,
	# a następnie podaje ścieżkę pliku projektu (klient wysyła tylko PROJECT=<slug>,
	# parametr MAP od klienta jest zawsze nadpisywany).
	handle /ows {
		# "route" = dyrektywy w kolejności zapisu. Bez niego Caddy sortuje je po swojemu
		# i "uri"/"rewrite" wykonują się PRZED forward_auth (API nie widzi PROJECT, MAP jest pusty).
		route {
			forward_auth api:8000 {
				uri /api/ows/authorize
				copy_headers X-Portal-User X-Portal-Groups X-Portal-Map
			}
			uri query MAP {http.request.header.X-Portal-Map}
			uri query -PROJECT
			rewrite * /
			# obraz camptocamp uruchomiony jako root słucha na porcie 80 (nie 8080)
			reverse_proxy qgis:80
		}
	}

	# --- WebUI (SPA) ---
	handle {
		reverse_proxy web:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
